# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# Local PostgreSQL. Create the database once:
#   psql -U postgres -c "CREATE DATABASE email_automation;"
# Leave DB_NAME empty to use a SQLite file (db.sqlite3) instead.
DB_NAME=email_automation
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Google Cloud > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Add GOOGLE_REDIRECT_URI exactly as below to the client's "Authorised redirect URIs",
# and enable the Gmail API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/gmail/callback/

# Google AI Studio API key, used when a campaign lets the AI write the emails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Seconds to wait between two sends (keeps Gmail from flagging the account).
SEND_INTERVAL_SECONDS=45
